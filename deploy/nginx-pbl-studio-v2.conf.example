# Replace the server name and certificate paths before enabling this file.
server {
    listen 443 ssl http2;
    server_name pbl.example.com;

    ssl_certificate /etc/letsencrypt/live/pbl.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pbl.example.com/privkey.pem;

    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Accounts may raise the application hard limit to 60 minutes.
        # Five extra minutes prevent the proxy from becoming the earlier timeout.
        proxy_connect_timeout 10s;
        proxy_send_timeout 65m;
        proxy_read_timeout 65m;
        send_timeout 65m;
    }
}
