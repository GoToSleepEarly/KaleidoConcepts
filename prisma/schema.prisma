generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  displayName String
  writingProvider StoryWritingProvider @default(quickrouter_gpt)
  aiGateway   AiGateway @default(quickrouter)
  quickRouterEndpoint QuickRouterEndpoint @default(main)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Person {
  id                  String              @id @default(cuid())
  role                PersonRole
  chineseName         String
  englishName         String
  age                 Int
  gender              Gender
  notes               String?
  activeVisualAssetId String?
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  activeVisualAsset   PersonVisualAsset?  @relation("ActivePersonVisual", fields: [activeVisualAssetId], references: [id], onDelete: SetNull)
  visualAssets        PersonVisualAsset[] @relation("PersonVisualAssets")
  coursePeople        CoursePerson[]
  courseCharacters    CourseCharacter[]

  @@index([role, archivedAt])
  @@index([chineseName])
  @@index([englishName])
}

model PersonVisualAsset {
  id                  String                  @id @default(cuid())
  personId            String
  parentAssetId       String?
  sourceMode          PersonVisualSourceMode
  appearanceConfig    Json?
  userInstruction     String?
  compiledPrompt      String
  sourceHash          String
  idempotencyKey      String
  status              PersonVisualStatus      @default(pending)
  provider            PersonVisualProvider
  providerImageUrl    String?
  storagePath         String?
  publicUrl            String?
  temporarySourcePath String?
  failureReason       String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  person              Person                   @relation("PersonVisualAssets", fields: [personId], references: [id], onDelete: Cascade)
  parentAsset         PersonVisualAsset?       @relation("PersonVisualVersions", fields: [parentAssetId], references: [id], onDelete: Restrict)
  childAssets         PersonVisualAsset[]      @relation("PersonVisualVersions")
  selectedBy          Person[]                 @relation("ActivePersonVisual")
  courseSnapshots     CoursePerson[]

  @@unique([personId, idempotencyKey])
  @@index([personId, createdAt])
  @@index([status, updatedAt])
}

model Course {
  id              String          @id @default(cuid())
  title           String
  durationMinutes Int
  englishLevel    EnglishLevel?
  grammarBookEditionId String?
  knowledgePointIds Json             @default("[]")
  lifecycleStatus CourseLifecycle @default(draft)
  currentStage    CourseStage     @default(audience)
  staleFromStage  CourseStage?
  visualQuality   CourseImageQuality @default(medium)
  imageGenerationConcurrency Int     @default(3)
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  people          CoursePerson[]
  storyOutline    CourseStoryOutline?
  storySetting     CourseStorySetting?
  storyDirections CourseStoryDirection[]
  storyMessages   CourseStoryChatMessage[]
  sourceReferences CourseSourceReference[]
  characters      CourseCharacter[]
  aiGenerationLogs AiGenerationLog[]
  teachingPlan    CourseTeachingPlan?
  lessonContent   CourseLessonContent?
  contentGenerations CourseContentGeneration[]
  contentMessages CourseContentChatMessage[]
  visualResourcePlan CourseVisualResourcePlan?
  characterVisuals CourseCharacterVisual[]
  visualImageSlots CourseVisualImageSlot[]
  images CourseImage[]
  presentation CoursePresentation?
  grammarBookEdition GrammarBookEdition? @relation(fields: [grammarBookEditionId], references: [id], onDelete: Restrict)

  @@index([lifecycleStatus, updatedAt])
}

model GrammarBookEdition {
  id            String             @id
  title         String
  edition       String
  officialLevel String
  sortOrder     Int
  sections      GrammarSection[]
  knowledgePoints KnowledgePoint[]
  courses       Course[]

  @@index([sortOrder])
}

model GrammarSection {
  id            String             @id
  bookEditionId String
  officialTitle String
  sortOrder     Int
  bookEdition   GrammarBookEdition @relation(fields: [bookEditionId], references: [id], onDelete: Cascade)
  knowledgePoints KnowledgePoint[]

  @@unique([bookEditionId, sortOrder])
  @@index([bookEditionId, sortOrder])
}

model KnowledgePoint {
  id            String               @id
  source        KnowledgePointSource
  bookEditionId String?
  sectionId     String?
  title         String
  sortOrder     Int
  bookEdition   GrammarBookEdition?  @relation(fields: [bookEditionId], references: [id], onDelete: Restrict)
  section       GrammarSection?      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  units         GrammarKnowledgePointUnit[]

  @@index([source, bookEditionId, sortOrder])
  @@index([sectionId, sortOrder])
}

model GrammarKnowledgePointUnit {
  knowledgePointId String
  unitNumber       Int
  officialTitle    String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([knowledgePointId, unitNumber])
  @@index([unitNumber])
}

model CoursePerson {
  id                      String             @id @default(cuid())
  courseId                String
  personId                String
  role                    PersonRole
  chineseNameSnapshot     String
  englishNameSnapshot     String
  ageSnapshot             Int
  genderSnapshot          Gender
  visualAssetIdSnapshot   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  course                  Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  person                  Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  visualAssetSnapshot     PersonVisualAsset? @relation(fields: [visualAssetIdSnapshot], references: [id], onDelete: Restrict)

  @@unique([courseId, personId])
  @@index([personId, createdAt])
}

model PresetOption {
  id         String           @id @default(cuid())
  kind       PresetOptionKind
  label      String
  labelZh    String?
  category   String?
  sortOrder  Int              @default(0)
  archivedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([kind, label])
  @@index([kind, archivedAt])
}

model CourseStoryOutline {
  id              String               @id @default(cuid())
  courseId        String               @unique
  chapterCount    Int
  title           String
  summary         String
  writingProvider StoryWritingProvider @default(quickrouter_gpt)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters        CourseStoryOutlineChapter[]
}

model CourseStorySetting {
  id              String               @id @default(cuid())
  courseId        String               @unique
  chapterCount    Int
  writingProvider StoryWritingProvider @default(quickrouter_gpt)
  storyComplexity StoryComplexity?
  alignmentStatus StoryAlignmentStatus @default(idle)
  planningMode StoryPlanningMode @default(explore_options)
  alignmentSummary String?
  alignmentDetails Json @default("{}")
  alignmentConfirmedAt DateTime?
  stateRevision Int @default(0)
  operationRequestId String?
  operationAction String?
  operationPhase String?
  operationStatus StoryOperationStatus?
  operationError String?
  operationInput Json?
  operationStartedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseStoryDirection {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  hook            String
  whyFits         String
  mainCharacters  Json
  storyHighlight  String   @default("")
  growthCore      String   @default("")
  classroomValue  String
  seedPrompt      String
  selectedAt      DateTime?
  createdAt       DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model CourseStoryChatMessage {
  id        String              @id @default(cuid())
  courseId  String
  role      CourseStoryChatRole
  content   String
  actions   Json?
  createdAt DateTime            @default(now())
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model CourseSourceReference {
  id                 String                    @id @default(cuid())
  courseId           String
  name               String
  type               CourseSourceReferenceType
  sourceStatus       CourseSourceStatus        @default(confirmed)
  summary            String
  usableFacts        Json
  avoidTopics        Json
  adaptationBoundary String
  researchProvider   StoryResearchProvider     @default(none)
  confirmedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  course             Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  characters         CourseCharacter[]

  @@index([courseId, name])
}

model CourseCharacter {
  id                   String                    @id @default(cuid())
  courseId             String
  displayName          String
  englishName          String
  sourceType           CourseCharacterSourceType
  sourcePersonId       String?
  sourceReferenceId    String?
  roleInStory          String
  shortDescription     String
  visualDescription    String?
  shouldAppearInImages Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  course               Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourcePerson         Person?                   @relation(fields: [sourcePersonId], references: [id], onDelete: SetNull)
  sourceReference      CourseSourceReference?    @relation(fields: [sourceReferenceId], references: [id], onDelete: SetNull)
  visual               CourseCharacterVisual?

  @@index([courseId, sourceType])
  @@index([sourcePersonId])
  @@index([sourceReferenceId])
}

model CourseStoryOutlineChapter {
  id          String             @id @default(cuid())
  outlineId   String
  order       Int
  title       String
  storyGoal   String
  keyEvents   Json
  characterIds Json
  setting     String
  endingHook  String
  recommendedKnowledgePointIds Json @default("[]")
  knowledgePointRecommendationSummary String @default("")
  outline     CourseStoryOutline @relation(fields: [outlineId], references: [id], onDelete: Cascade)

  @@unique([outlineId, order])
}

model CourseTeachingPlan {
  id                 String             @id @default(cuid())
  courseId           String             @unique
  status             TeachingPlanStatus @default(draft)
  englishLevel       EnglishLevel?
  mainIdeaTargetWordCount Int             @default(120)
  chapters           Json
  afterClassPractice Json
  confirmedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  course             Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseCharacterVisual {
  id                  String                    @id @default(cuid())
  courseId            String
  characterId         String                    @unique
  intent              CharacterVisualIntent?
  source              CharacterVisualSource?
  personVisualAssetId String?
  activeImageId       String?
  status              CharacterVisualStatus     @default(missing)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  course              Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  character           CourseCharacter            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  activeImage         CourseImage?               @relation("ActiveCharacterVisual", fields: [activeImageId], references: [id], onDelete: SetNull)
  images              CourseImage[]              @relation("CharacterVisualImages")

  @@index([courseId, status])
  @@index([personVisualAssetId])
}

model CourseVisualResourcePlan {
  id                    String         @id @default(cuid())
  courseId              String         @unique
  sourceRevision        String
  revision              Int            @default(1)
  mode                  VisualPlanMode @default(faithful)
  coverBrief            Json
  confirmedCoverAssetId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  course                Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseVisualImageSlot {
  id            String              @id @default(cuid())
  courseId      String
  stableKey     String
  slotType      CourseImageSlotType
  chapterId     String?
  paragraphId   String?
  sourceText    String
  characterIds  Json
  focus         String
  sceneDescription String              @default("")
  prompt        String
  activeImageId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activeImage   CourseImage?        @relation("ActiveSlotImage", fields: [activeImageId], references: [id], onDelete: SetNull)
  images        CourseImage[]       @relation("SlotImages")

  @@unique([courseId, stableKey])
  @@index([courseId, chapterId])
}

model CourseImage {
  id                String                   @id @default(cuid())
  courseId          String
  slotId            String?
  characterVisualId String?
  parentAssetId     String?
  operation         CourseImageOperation
  userInstruction   String?
  prompt            String
  quality           CourseImageQuality
  referenceAssetIds Json                     @default("[]")
  sourceHash        String
  planRevision      Int                      @default(1)
  idempotencyKey    String
  status            CourseImageStatus        @default(pending)
  provider          CourseImageProvider      @default(quickrouter_gpt_image_2)
  providerTaskId    String?
  providerImageUrl  String?
  storagePath       String?
  publicUrl          String?
  temporarySourcePath String?
  failureReason     String?
  failureCode       CourseImageFailureCode?
  attempt           Int                      @default(0)
  leaseToken        String?
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  course            Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slot              CourseVisualImageSlot?   @relation("SlotImages", fields: [slotId], references: [id], onDelete: Cascade)
  characterVisual   CourseCharacterVisual?   @relation("CharacterVisualImages", fields: [characterVisualId], references: [id], onDelete: Cascade)
  parentAsset       CourseImage?              @relation("CourseImageVersions", fields: [parentAssetId], references: [id], onDelete: Restrict)
  childAssets       CourseImage[]             @relation("CourseImageVersions")
  selectedBySlots   CourseVisualImageSlot[]   @relation("ActiveSlotImage")
  selectedByCharacters CourseCharacterVisual[] @relation("ActiveCharacterVisual")

  @@unique([courseId, idempotencyKey])
  @@index([courseId, status])
  @@index([courseId, status, leaseExpiresAt])
  @@index([slotId, createdAt])
  @@index([characterVisualId, createdAt])
}

model CourseLessonContent {
  id                 String              @id @default(cuid())
  courseId           String              @unique
  status             CourseContentStatus @default(empty)
  phase              CourseContentPhase?
  writingProvider    StoryWritingProvider @default(quickrouter_gpt)
  sourceRevision     String              @default("")
  contentVersion     Int                 @default(0)
  chapters           Json                @default("[]")
  mainIdea           Json?
  homework           Json?
  exercisesStale     Boolean             @default(false)
  errorMessage       String?
  activeGenerationId String?
  confirmedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CoursePresentation {
  courseId          String   @id
  coverTheme        String   @default("dark")
  coverTitleFontSize Float   @default(1.0)
  chapterTheme      String   @default("blue-purple")
  slideOverrides    Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseContentGeneration {
  id             String                        @id @default(cuid())
  courseId       String
  operation      CourseContentOperation
  sourceRevision String
  idempotencyKey String
  status         CourseContentGenerationStatus @default(running)
  attempt        Int                           @default(0)
  baseContentVersion Int                       @default(0)
  previousStatus CourseContentStatus           @default(empty)
  leaseExpiresAt DateTime                      @default(now())
  startedAt      DateTime                      @default(now())
  errorMessage   String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  course         Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, idempotencyKey])
  @@unique([courseId, sourceRevision, operation])
  @@index([courseId, createdAt])
  @@index([courseId, status, leaseExpiresAt])
}

model CourseContentChatMessage {
  id         String                @id @default(cuid())
  courseId   String
  role       CourseStoryChatRole
  content    String
  targetType CourseContentTargetType?
  targetId   String?
  kind       CourseContentTimelineKind?
  status     CourseContentTimelineStatus?
  operation  CourseContentOperation?
  requestId  String?
  title      String?
  details    Json?
  eventKey   String?
  createdAt  DateTime              @default(now())
  course     Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, eventKey])
  @@index([courseId, createdAt])
  @@index([courseId, requestId, createdAt])
}

model AiGenerationLog {
  id               String                  @id @default(cuid())
  requestId        String?                 @unique
  courseId         String?
  stage            String
  operation        String
  status           AiGenerationStatus
  writingProvider  StoryWritingProvider?
  researchProvider StoryResearchProvider?
  inputSnapshot    Json
  outputSnapshot   Json?
  errorMessage     String?
  latencyMs        Int?
  createdAt        DateTime                @default(now())
  course           Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([stage, operation, createdAt])
}

enum AiGateway {
  quickrouter
  crazyrouter
}

enum QuickRouterEndpoint {
  main
  direct
}

enum PersonRole {
  student
  teacher
}

enum Gender {
  male
  female
}

enum PersonVisualSourceMode {
  photo
  description
  revision
}

enum PersonVisualStatus {
  pending
  submitting
  succeeded
  failed
}

enum PersonVisualProvider {
  quickrouter_gpt_image_2
  crazyrouter_gpt_image_2
}

enum CourseLifecycle {
  draft
  published
  archived
}

enum CourseStage {
  audience
  story_outline
  teaching_plan
  content
  visual_resources
  preview
}

enum PresetOptionKind {
  theme
  story_type
  story_tone
  grammar
}

enum KnowledgePointSource {
  legacy
  grammar_in_use
}

enum StoryWritingProvider {
  quickrouter_gpt
  quickrouter_deepseek
}

enum StoryAlignmentStatus {
  idle
  needs_clarification
  ready_for_confirmation
  confirmed
}

enum StoryPlanningMode {
  explore_options
  follow_defined_plot
}

enum StoryComplexity {
  clear_linear
  conflict_driven
  layered
}

enum StoryResearchProvider {
  quickrouter_gpt
  none
}

enum CourseStoryChatRole {
  teacher
  assistant
  system
}

enum CourseSourceReferenceType {
  real_person
  historical_person
  public_figure
  ip
  game_character
  fictional_character
  other
}

enum CourseSourceStatus {
  confirmed
  insufficient
  teacher_supplied
}

enum CourseCharacterSourceType {
  person
  referenced
  original
}

enum CharacterVisualIntent {
  preserve_identity
  originalize
}

enum CharacterVisualSource {
  person_asset
  uploaded_reference
  generated_baseline
}

enum CharacterVisualStatus {
  missing
  generating
  ready
  failed
  stale
}

enum CourseImageSlotType {
  character_baseline
  visual_cover
  lesson_shot
}

enum CourseImageOperation {
  initial
  revision
}

enum CourseImageQuality {
  low
  medium
  high
}

enum VisualPlanMode {
  faithful
  originalized
}

enum CourseImageFailureCode {
  retryable
  storage_recoverable
  provider_result_invalid
  invalid_request
  policy_blocked
  unknown
}

enum CourseImageStatus {
  pending
  submitting
  generating
  succeeded
  failed
}

enum CourseImageProvider {
  quickrouter_gpt_image_2
  crazyrouter_gpt_image_2
}

enum AiGenerationStatus {
  running
  succeeded
  failed
}

enum TeachingPlanStatus {
  draft
  confirmed
}

enum StoryOperationStatus {
  running
  succeeded
  failed
  result_unknown
  superseded
}

enum CourseContentStatus {
  empty
  generating_reading
  reading_ready
  generating_exercises
  ready
  failed
  confirmed
}

enum CourseContentPhase {
  preparing
  generating_chapters
  validating_chapters
  repairing_chapters
  generating_main_idea
  validating_main_idea
  repairing_main_idea
  generating_exercises
  validating_exercises
}

enum CourseContentOperation {
  reading
  exercises
  modify
}

enum CourseContentGenerationStatus {
  running
  succeeded
  failed
  result_unknown
}

enum CourseContentTimelineKind {
  message
  operation
  repair
  notice
}

enum CourseContentTimelineStatus {
  running
  succeeded
  failed
  stale
}

enum CourseContentTargetType {
  chapter
  paragraph
  chapter_practice
  main_idea
  homework
}

enum EnglishLevel {
  Starter
  A1
  A2
  B1
  B2
  C1
  C2
}
