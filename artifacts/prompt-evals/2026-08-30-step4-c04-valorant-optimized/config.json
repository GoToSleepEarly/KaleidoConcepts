      "outline": {
        "id": "cmsx9i82l000cuwvontzfte0z",
        "title": "港口里的镜面 Boss / The Mirror Boss at the Harbor",
        "summary": "林老师和子轩进入夜间港口训练场，和 Jett、Sage 一起护送辐能安全箱。镜面守卫偷走安全箱，并用复制最近动作的规则反击小队。子轩记录 Boss 复制的动作，林老师引导大家改变战斗节奏，Jett 和 Sage 用假动作与真正的屏障制造转折。最后小队夺回安全箱，关闭复制程序，港口吊塔恢复安全。",
        "chapters": [
          {
            "id": "cmsx9i834000duwvo24ja8mmb",
            "order": 1,
            "title": "安全箱被抢走 / The Safety Box Is Taken",
            "summary": "林老师和子轩来到港口训练场，和 Jett、Sage 护送辐能安全箱到控制台。镜面守卫突然出现，复制 Jett 的快速冲刺并抢走安全箱。小队发现 Boss 会模仿最近的动作，安全箱现在被带到吊塔下方。",
            "recommendedKnowledgePointIds": [
              "essential-grammar-in-use-4-u14"
            ],
            "knowledgePointRecommendationSummary": "Contrast the ongoing escort with the Mirror Guard's completed interruption."
          },
          {
            "id": "cmsx9i834000euwvo8y18uioe",
            "order": 2,
            "title": "记录最近的动作 / Writing the Last Move",
            "summary": "小队追到吊塔下方，但 Boss 又复制 Sage 的防护动作，让大家无法直接靠近安全箱。子轩开始用简单句记录 Boss 每次复制的最近动作，林老师据此要求大家先停一下再行动。小队确认 Boss 只能复制最近一次明显的能力动作，下一步可以故意给它错误目标。",
            "recommendedKnowledgePointIds": [
              "essential-grammar-in-use-4-u8"
            ],
            "knowledgePointRecommendationSummary": "Contrast the Guard's fixed copying rule with actions the team is observing and recording now."
          },
          {
            "id": "cmsx9i834000fuwvowoyht2re",
            "order": 3,
            "title": "假冲刺与真屏障 / A Fake Dash and a Real Wall",
            "summary": "镜面守卫开始连接吊塔程序，准备用安全箱控制港口吊塔。Jett 做出假冲刺，引导 Boss 复制错误方向；Sage 立刻立起真正的屏障，林老师带子轩靠近并关闭复制程序。小队夺回安全箱，吊塔停止移动，子轩也用记录帮助大家赢下这场战斗。",
            "recommendedKnowledgePointIds": [
              "essential-grammar-in-use-4-u54"
            ],
            "knowledgePointRecommendationSummary": "Use purpose infinitives for the fake dash, real wall, approach to the console, and shutdown plan."
          }
        ]
