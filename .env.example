DATABASE_URL="postgresql://user:password@localhost:5432/pbl_studio?schema=public"
# QuickRouter 文本和图片使用独立 token，禁止互相回退
QUICKROUTER_TEXT_API_KEY="replace-with-quickrouter-text-api-key"
QUICKROUTER_IMAGE_API_KEY="replace-with-quickrouter-image-api-key"
QUICKROUTER_GPT_TEXT_MODEL="gpt-5.5"
QUICKROUTER_DEEPSEEK_TEXT_MODEL="deepseek-v4-flash"
QUICKROUTER_RESEARCH_MODEL="gpt-5.5"
QUICKROUTER_IMAGE_MODEL="gpt-image-2"
TEXT_GENERATION_TIMEOUT_MS="600000"
COURSE_CONTENT_GENERATION_TIMEOUT_MS="600000"
# QuickRouter 生图请求超时，默认 10 分钟
IMAGE_GENERATION_TIMEOUT_MS="600000"
STORAGE_DIR="./storage/images"
