NODE_ENV="production"
# 生产 HTTPS 保持 true；仅在临时 HTTP 公网访问期间设为 false
AUTH_COOKIE_SECURE="true"
HOSTNAME="127.0.0.1"
PORT="3100"
APP_NAME="pbl-studio-v2"
BRANCH="master"
DATABASE_URL="postgresql://pbl_v2_app:replace-with-database-password@localhost:5432/pbl_studio_v2?schema=public"
DATABASE_URL_FOR_PG_DUMP="postgresql://pbl_v2_app:replace-with-database-password@localhost:5432/pbl_studio_v2"
STORAGE_DIR="/data/pbl-studio-v2/images"
BACKUP_DIR="/data/backups/pbl-studio-v2"
# 仅在首次创建预置账号时使用；后续 seed 不会覆盖已有密码
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
# QuickRouter 文本和图片使用独立 token，禁止互相回退；模型由账户高级设置决定
QUICKROUTER_TEXT_API_KEY="replace-with-quickrouter-text-api-key"
QUICKROUTER_IMAGE_API_KEY="replace-with-quickrouter-image-api-key"
# DeepSeek 使用官方地址，模型由账户高级设置决定
DEEPSEEK_TEXT_API_KEY="replace-with-deepseek-text-api-key"
# Crazyrouter 文本和图片使用独立 token，禁止互相回退
CRAZYROUTER_TEXT_API_KEY="replace-with-crazyrouter-text-api-key"
CRAZYROUTER_IMAGE_API_KEY="replace-with-crazyrouter-image-api-key"
# Easy88AI 文本和图片使用独立 token，禁止互相回退
EASY88AI_TEXT_API_KEY="replace-with-easy88ai-text-api-key"
EASY88AI_IMAGE_API_KEY="replace-with-easy88ai-image-api-key"
# 文本流式开关和全部文本超时只由账户高级设置管理，不读取环境变量
# 图片生成请求超时，默认 10 分钟
IMAGE_GENERATION_TIMEOUT_MS="600000"
